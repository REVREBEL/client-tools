# Clerk development credentials for the local Fumadocs auth preview.
# Copy this file to .env.local and replace the placeholders with your Clerk dev keys.
#
# The publishable key is browser-safe and is used by the Clerk React components.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_development_publishable_key

# The secret key is server-only. Keep it out of client components and never commit a real value.
# It is included here so the design-system app can use Clerk server APIs later if needed.
CLERK_SECRET_KEY=sk_test_your_development_secret_key
