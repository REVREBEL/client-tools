{
  "name": "@revrebel/client-tools",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter='./apps/*'",
    "build": "turbo run build --filter='./apps/*'",
    "lint": "turbo run lint --filter='./apps/*'",
    "typecheck": "turbo run typecheck --filter='./apps/*'",
    "dev:docs": "turbo run dev --filter=@revrebel/docs",
    "dev:metrics": "turbo run dev --filter=@revrebel/metrics",
    "dev:playlist": "turbo run dev --filter=@revrebel/playlist",
    "dev:onboard": "turbo run dev --filter=@revrebel/onboard",
    "dev:design": "turbo run dev --filter=@revrebel/design-system-docs",
    "build:docs": "turbo run build --filter=@revrebel/docs",
    "build:metrics": "turbo run build --filter=@revrebel/metrics",
    "build:playlist": "turbo run build --filter=@revrebel/playlist",
    "build:onboard": "turbo run build --filter=@revrebel/onboard",
    "build:design": "turbo run build --filter=@revrebel/design-system-docs",
    "legacy:dev": "next dev",
    "legacy:build": "next build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.2.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "wrangler": "^4.92.0"
  },
  "type": "module"
}
