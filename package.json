{
  "name": "revrebel-client-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "design-system",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app portal/docs/app portal/metrics/app portal/playlist/app portal/playlist/Components middleware.ts",
    "typecheck": "tsc --noEmit",
    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "lint:all": "turbo run lint",
    "typecheck:all": "turbo run typecheck",
    "portal:dev": "next dev",
    "portal:build": "next build",
    "design:dev": "turbo run dev --filter=@revrebel/design-system-docs",
    "design:build": "turbo run build --filter=@revrebel/design-system-docs",
    "design:typecheck": "turbo run typecheck --filter=@revrebel/design-system-docs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.2.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "wrangler": "^4.92.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260907.1": true
  }
}
